{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "/logo\\.jpeg", "dest": "/logo.jpeg" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
