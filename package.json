{
  "name": "control-asistencia-cec",
  "version": "1.0.0",
  "description": "Control de Asistencia y Registro de Campo para Vendedores",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file .env server.js",
    "seed": "node --env-file .env src/config/seed.js",
    "importar:estructura": "node --env-file .env scripts/importar_estructura.js",
    "dev": "node --env-file .env --watch server.js",
    "test": "node --env-file .env --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "firebase-admin": "^14.2.0",
    "xlsx": "^0.18.5"
  }
}
